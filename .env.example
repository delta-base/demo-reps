# ElevenLabs settings for voice pitch practice. Copy this file to .env and fill it in.
# Never commit .env.

# The agent's ID, from elevenlabs.io → ElevenAgents → your agent (starts with agent_)
ELEVENLABS_AGENT_ID=

# Optional: only needed if the agent is private (Security → "Enable authentication").
# Create one at elevenlabs.io → Developers → API Keys. It needs ElevenAgents access.
ELEVENLABS_API_KEY=
